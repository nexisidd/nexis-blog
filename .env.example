# --- Obrigatórias ---

# String de conexão do Postgres no Neon (use a connection string "pooled" com sslmode=require)
DATABASE_URI=postgres://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Segredo do Payload (gere com: openssl rand -hex 32). Nunca reutilize o de desenvolvimento.
PAYLOAD_SECRET=

# Endereço do painel (Render), sem barra no fim
NEXT_PUBLIC_SERVER_URL=https://nexis-blog-painel.onrender.com

# Endereço público do blog (Cloudflare Pages), sem barra no fim.
# Precisa ser igual no painel (Render) e no build do site (Cloudflare Pages).
NEXT_PUBLIC_SITE_URL=https://blog.iddnexis.com.br

# Site principal (usado no @id da Organization, links e CTAs)
NEXT_PUBLIC_MAIN_SITE_URL=https://iddnexis.com.br

# --- Imagens: Cloudflare R2 (ou S3). Sem S3_BUCKET, as imagens vão para o disco local (só para desenvolvimento). ---
S3_BUCKET=
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública do bucket (domínio do R2 ou r2.dev). OBRIGATÓRIA com o site no Cloudflare Pages:
# o site estático não tem servidor para entregar as imagens.
S3_PUBLIC_URL=

# --- E-mail (convites e "esqueci minha senha"). Sem SMTP_HOST, os e-mails só aparecem no log. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=blog@iddnexis.com.br
EMAIL_FROM_NAME=Blog da Nexis

# --- Jobs (publicação agendada e convites) ---
# O próprio servidor processa a fila a cada minuto. Use "false" só se for processar por Cron Job externo.
JOBS_AUTORUN=true
# Segredo para um Cron Job chamar GET /api/payload-jobs/run com "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# --- Cloudflare Pages ---
# Deploy Hook do projeto (Settings › Builds › Deploy hooks). Só no painel (Render).
# Ao publicar, o painel chama este endereço e o Cloudflare reconstrói o site.
PAGES_DEPLOY_HOOK_URL=

# --- Opcionais ---
# Segredo da rota interna de revalidação usada pela publicação agendada (padrão: PAYLOAD_SECRET)
REVALIDATE_SECRET=
# URLs dos CTAs (padrão: iddnexis.com.br/#modo-sombra e /#contato)
NEXT_PUBLIC_CTA_MODO_SOMBRA_URL=
NEXT_PUBLIC_CTA_CONTATO_URL=
# Logo da Organization no JSON-LD (use a mesma URL do bloco da home)
NEXT_PUBLIC_ORGANIZATION_LOGO_URL=

# Só para o seed (npm run seed): cria o primeiro admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
